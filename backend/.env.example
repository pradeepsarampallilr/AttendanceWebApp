DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Okta access-token validation. Leave OKTA_ISSUER blank to disable auth (local dev / tests).
OKTA_AUDIENCE=
OKTA_CLIENT_ID=
OKTA_ISSUER=

# Which token claim must match app_users.email: preferred_username (Okta login), email, or sub. Empty = login, then email.
OKTA_IDENTITY_CLAIM=

# The single superadmin: always allowed, and the only one who can add/remove HR users. Managers come from the roster upload.
SUPERADMIN_EMAIL=
